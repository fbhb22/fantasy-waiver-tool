# From https://developer.yahoo.com/apps/ -> your app
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Yahoo league key, e.g. "423.l.123456" (game_key.l.league_id) - find via league URL or list_leagues.py
YAHOO_LEAGUE_KEY=

# ESPN (unofficial API - no developer app needed)
# League id: the leagueId=... number in your league's fantasy.espn.com URL
ESPN_LEAGUE_ID=
ESPN_YEAR=2026
# Private leagues only: cookies from a logged-in fantasy.espn.com session
# (Chrome DevTools > Application > Cookies > https://fantasy.espn.com). SWID includes the {braces}.
ESPN_S2=
ESPN_SWID=
